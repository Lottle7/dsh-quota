{
  "name": "dsh-quota",
  "version": "0.5.0",
  "description": "Quota, balance, token analytics, pricing and route diagnostics for DeepSeek HARNESS Web.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lottle7/dsh-quota.git"
  },
  "homepage": "https://github.com/Lottle7/dsh-quota#readme",
  "bugs": {
    "url": "https://github.com/Lottle7/dsh-quota/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "llm",
    "quota",
    "token-usage",
    "cost-monitoring"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/assets/quota-center.png"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs lib/client.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test tests/*.spec.ts",
    "test:loader": "npm run build && node tests/client-loader-smoke.mjs",
    "test:ci": "npm run typecheck && npm test && npm run test:loader",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.5",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6"
  },
  "overrides": {
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6"
  }
}
